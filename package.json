{
  "name": "ai-billing",
  "version": "1.0.0",
  "description": "AI Bill point-of-sale, inventory and customer accounts",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ignore node_modules server.js",
    "check": "node --check server.js && node --check app.js && node --check routes/index.js",
    "migrate:vendor-ledger": "node scripts/migrate-vendor-ledger.js",
    "migrate:raw-materials": "node scripts/migrate-raw-materials.js",
    "migrate:boq-inventory": "node scripts/migrate-boq-inventory.js",
    "migrate:made-to-order": "node scripts/migrate-made-to-order.js",
    "migrate:grocery": "node scripts/migrate-grocery-schema.js",
    "seed": "node seed.js",
    "seed:demo": "node seed-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
